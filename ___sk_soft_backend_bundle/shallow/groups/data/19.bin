// Demo code.

type foo<T> = i32;
enum bar {
    Some(i32, foo<f32>),
    None
}

fn check_crate(x: i32) {
    let v = 10;
    match foo {
        1 ... 3 {
            print_foo();
            if x {
                blah().to_string();
            }
        }
        (x, y) { "bye" }
        _ { "hi" }
    }
}
