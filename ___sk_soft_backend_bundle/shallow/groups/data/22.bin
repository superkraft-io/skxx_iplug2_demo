    eq(cm.getValue(), "one\ntwothree\nfour\n")
  }, {inputStyle: "contenteditable", value: "one\ntwo\nfoo\nbar\nthree\nfour\n"})

  testCM("ambiguous_diff_middle", function(cm) {
