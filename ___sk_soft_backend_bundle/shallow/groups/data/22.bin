  }, {inputStyle: "contenteditable", value: "baah"})

  testCM("ambiguous_diff_start", function(cm) {
    cm.setSelection(Pos(0, 1))
    findTextNode(cm, "baah").nodeValue = "baaah"
    cm.display.input.updateFromDOM()
