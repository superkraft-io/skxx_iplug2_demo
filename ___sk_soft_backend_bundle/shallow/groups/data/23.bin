  CodeMirror.Vim.map('w', 'l', 'normal');
  cm.setCursor(0, 0);
  helpers.assertCursorAt(0, 0);
  helpers.doKeys('w');
  helpers.assertCursorAt(0, 1);
  CodeMirror.Vim.mapclear('normal');
  helpers.doKeys('w');
  helpers.assertCursorAt(0, 4);
  CodeMirror.Vim.mapclear();
}, { value: 'abc abc' });

