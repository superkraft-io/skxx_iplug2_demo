  expr: '1,3s/\\d/0/ 3'});
testSubstitute('ex_substitute_not_global', {
  value: 'aaa\nbaa\ncaa',
  expectedValue: 'xaa\nbxa\ncxa',
  expr: '%s/a/x/'});
testSubstitute('ex_substitute_optional', {
  value: 'aaa  aa\n aa',
  expectedValue: '<aaa> <> <aa>\n<> <aa>',
