         "goSubwordLeft", at(1, 6),
         "goSubwordLeft", at(1, 3),
         "goSubwordLeft", at(1, 1),
         "goSubwordLeft", at(1, 0),
         "goSubwordLeft", at(0, 22),
         "goSubwordLeft", at(0, 18),
