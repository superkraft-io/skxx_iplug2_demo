  helpers.assertCursorAt(3, 0);
}, { value: 'a\nb\nc\nd\ne\n'});
testVim('ex_go_to_mark', function(cm, vim, helpers) {
  cm.setCursor(3, 0);
  helpers.doKeys('m', 'a');
