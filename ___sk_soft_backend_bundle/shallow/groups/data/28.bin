.ui.ui.ui.calendar.popup > .ui.ui.grid > .column:not(:last-child) {
  padding-right: 0;
}
.ui.ui.ui.calendar.popup > .ui.ui.grid > .column:not(:last-child) > .ui.table {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

