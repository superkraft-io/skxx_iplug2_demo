/* -------------------
           Inline
    -------------------- */
.ui.inline.loader {
  position: relative;
  vertical-align: middle;
  margin: 0;
  left: 0;
  top: 0;
  transform: none;
}
.ui.inline.loader.active,
.ui.inline.loader.visible {
