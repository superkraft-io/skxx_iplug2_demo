    }
}

class sk_ui_table_row extends sk_ui_component {
    constructor(opt){
        super(opt)

        this.columns = new sk_ui_table_columns()
    }

    addColumn(opt){
        this.parent.add.fromNew(sk_ui_table_row)
    }

    get columns(){ return this.container.children.children }
}


class sk_ui_table_column extends sk_ui_component {
    constructor(opt){
        super(opt)
    }
}.sk_ui_text {
    line-height: initial;
}class sk_ui_text extends sk_ui_label {
    constructor(opt){
        super(opt)
    }
}.sk_ui_textarea {
    height: 36px;
    background-color: #202020;
    color: white !important;
    padding: 4px 8px;
    border: solid 1px #414141;;
    border-radius: 8px;
    transition: none;
}

.sk_ui_textarea::selection {
    background:rgb(93, 177, 255);
    color: white;
}class sk_ui_textarea extends sk_ui_component {
    constructor(opt){
        super({...opt, ...{htmlTag: 'textarea'}})

        this.classRemove('sk_ui_noSelect')

        this.attributes.add({friendlyName: 'Value', name: 'value', type: 'text', onSet: val => {
            this.element.value = val
            if (this.onChanged) this.onChanged(this.element.value)
        }, onGet: val => { return this.element.value }})
        this.attributes.add({friendlyName: 'Name', name: 'name', type: 'text', onSet: val => { this.element.name = val }})
        this.attributes.add({friendlyName: 'Placeholder', name: 'placeholder', type: 'text', onSet: val => { this.element.placeholder = val }})


        this.element.addEventListener('input', _e => {
            if (this.onChanged) this.onChanged(this.element.value)
        })
    }
}