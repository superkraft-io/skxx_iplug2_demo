
.sk_fileDrop_active {
    border: dashed 1px rgba(255,255,255,1)
}


.sk_ui_fileDrop_Area {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    margin: 0px !important;
    /*backdrop-filter: blur(10px);
    background-color: rgba(255,255,255,0.2);
    */

    margin: 0px !important
}

.sk_ui_fileDrop_Area_outline {
    width: 100%;
    height: 100%;
    border: dashed 2px rgba(255,255,255,0.2);
    transition: none;
}

/*.sk_ui_fileDrop_Area_outline:hover {
    background-color: rgba(255,255,255,0.8);
}*/
class sk_ui_fileDrop_Area extends sk_ui_component {
    constructor(opt){
        super(opt)

        this.pointerEvents = 'none'

        this.outline = this.add.component(_c => {
            _c.classAdd('sk_ui_fileDrop_Area_outline')
            _c.pointerEvents = 'none'
        })
    }
}
.sk_ui_gradient_default {
    color: #fff;
    background: linear-gradient(-45deg, #23d5ab, #23a6d5, #e73c7e, #ee7752);
    background-size: 400% 400%!important;
    animation: sk_ui_gradient_default 15s ease infinite;
}


@keyframes sk_ui_gradient_default {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@-moz-keyframes sk_ui_gradient_default {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}




.sk_ui_gradient_dark {
    color: #fff;
    background: linear-gradient(-45deg, #91a100, #0e5987, #61092b, #ce3000);
    background-size: 400% 400%;
    animation: 15s ease 0s infinite normal none running sk_ui_gradient_dark;
}
  
@keyframes sk_ui_gradient_dark {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@-moz-keyframes sk_ui_gradient_dark {
