sk_api.__protonjs = {
    window_uuid_counter: "0",
    next_window_uuid: () => {
        var counterAsInt = parseInt(sk_api.__protonjs.window_uuid_counter)
        counterAsInt++
        sk_api.__protonjs.window_uuid_counter = counterAsInt.toString()
        return sk_api.__protonjs.window_uuid_counter
    },

    windows: {}
}

