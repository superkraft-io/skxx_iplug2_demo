module.exports = new SK_Module_os('os')sk_api.path = {
    dirname(path) {
        var split = this.unixify(path).split('/')
        split.splice(split.length - 1, 1)
        return split.join('/')
    },

    extname(path) {
        var split = path.split('.')
        return '.' + split[split.length - 1]
    },

    basename(path) {
        var split = this.unixify(path).split('/')
        return split[split.length - 1]
    },

    unixify(path) {
        return path.split('\\\\').join('\\').split('\\').join(' / ')
    },
}

